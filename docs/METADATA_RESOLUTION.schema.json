{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:save-webp-meta:resolution-report:1",
  "title": "Save WEBP Meta internal resolution report v1 (not an embedded image format)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "save_node_id",
    "image",
    "status",
    "fields",
    "producers",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "save_webp_meta.resolve/1"
    },
    "save_node_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "channels",
        "batch_index"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "enum": [
            1,
            3,
            4
          ]
        },
        "batch_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "ambiguous",
        "external"
      ]
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/field"
      }
    },
    "producers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "output_slot",
          "class_type",
          "stage_index"
        ],
        "properties": {
          "node_id": {
            "type": "string"
          },
          "output_slot": {
            "type": "integer",
            "minimum": 0
          },
          "class_type": {
            "type": "string"
          },
          "stage_index": {
            "type": "integer",
            "minimum": 0
          },
          "output_variant": {
            "type": "string"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "node_id": {
            "type": "string"
          },
          "field": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "certainty"
      ],
      "properties": {
        "source": {
          "enum": [
            "runtime_prompt",
            "workflow_named",
            "workflow_positional",
            "verified_provider",
            "image_tensor",
            "derived"
          ]
        },
        "certainty": {
          "enum": [
            "explicit",
            "derived",
            "hint"
          ]
        },
        "node_id": {
          "type": "string"
        },
        "output_slot": {
          "type": "integer",
          "minimum": 0
        },
        "input_name": {
          "type": "string"
        },
        "provider_id": {
          "type": "string"
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "enum": [
            "known",
            "known_empty",
            "not_applicable",
            "unresolved",
            "ambiguous"
          ]
        },
        "value": {},
        "reason": {
          "type": "string"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "known"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "not": {
                  "type": "null"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "known_empty"
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not_applicable",
                  "unresolved",
                  "ambiguous"
                ]
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ],
            "not": {
              "required": [
                "value"
              ]
            }
          }
        }
      ]
    }
  }
}
